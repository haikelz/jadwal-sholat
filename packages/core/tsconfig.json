{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@jadwal-sholat/typescript-config/base.json",
  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "types": ["bun"],
    "verbatimModuleSyntax": true
  },
  "include": ["src", "scripts"]
}
