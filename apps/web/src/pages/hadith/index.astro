---
import { PageHeader, PageShell } from "@/components/common/page-shell";
import { buildBooksUrl, buildHadithApiUrl } from "@/components/hadith/hadith-page";
import { HadithListIsland } from "@/components/islands/hadith-list-island";
import type { HadithBooksResponse, HadithRangeResponse } from "@/interfaces";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getData } from "@/lib/utils/get-data";
import { breadcrumbJsonLd, toDescription } from "@/lib/utils/metadata";

// Bukhari's first page is built into the HTML, so crawlers reach hadith pages
// through links. Rows show two lines of the translation, so only a short
// snippet reaches the island, and no Arabic.
const [books, firstPage] = await Promise.all([
  getData<HadithBooksResponse>(buildBooksUrl()),
  getData<HadithRangeResponse>(buildHadithApiUrl("bukhari", 1)),
]);
const initialData = {
  books,
  firstPage: {
    ...firstPage,
    data: {
      ...firstPage.data,
      hadiths: firstPage.data.hadiths.map(({ number, id }) => ({
        number,
        arab: "",
        id: toDescription(id, 200),
      })),
    },
  },
};
---

<BaseLayout
  title="Kumpulan Hadith: Bukhari, Muslim dan Kitab Lainnya"
  description="Baca 38.000+ hadith dari kitab Bukhari, Muslim, Abu Daud, Tirmidzi, Nasa'i, Ibnu Majah, Ahmad, Darimi, dan Malik, dengan teks Arab dan terjemahan."
  path="/hadith"
  jsonLd={[breadcrumbJsonLd([{ name: "Hadith", path: "/hadith" }])]}
>
  <PageShell>
    <PageHeader
      title="Hadith"
      description="Kumpulan hadith Nabi Muhammad ﷺ berdasarkan kitab dan nomor."
    />
    <HadithListIsland client:load initialData={initialData} />
  </PageShell>
</BaseLayout>
