---
import { isNavItemActive, navItems } from "@/lib/nav";
import { cn } from "@/lib/utils/cn";

/** Thumb-reachable section tabs for phones; md and up use the top bar. */
const { path } = Astro.props as { path: string };
---

<nav
  aria-label="Navigasi bawah"
  class="fixed inset-x-0 bottom-0 z-40 border-t bg-background/95 pb-[env(safe-area-inset-bottom)] backdrop-blur md:hidden"
>
  <ul class="grid grid-cols-5">
    {
      navItems.map((item) => {
        const Icon = item.icon;
        const isActive = isNavItemActive(path, item.url);
        return (
          <li class="flex">
            <a
              href={item.url}
              aria-current={isActive ? "page" : undefined}
              class={cn(
                "flex min-h-14 w-full min-w-0 flex-col items-center justify-center gap-1 px-1 text-xs transition-colors outline-none focus-visible:ring-3 focus-visible:ring-ring/50 focus-visible:ring-inset",
                isActive
                  ? "font-medium text-foreground"
                  : "text-muted-foreground hover:text-foreground",
              )}
            >
              <Icon aria-hidden="true" className="size-5 shrink-0" />
              <span class="max-w-full truncate">{item.shortTitle}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
