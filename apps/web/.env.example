# Copy to .env. On Cloudflare Pages, set the same variables in the project's
# Variables and Secrets.

# Public API base URLs (required), read through astro:env.
ASMAUL_HUSNA_API=
HADITH_API=
JADWAL_SHOLAT_API=
NOMINATIM_API=
QURAN_API=

# Puasa sunnah API base URL (required), read by the /api/sunnah-fasting proxy
# while the site runs.
PUASA_SUNNAH_API=

# GoatCounter endpoint (optional), e.g. https://<your-goatcounter>/count; the
# script loads from the same address plus .js. Unset means no analytics.
GOATCOUNTER_URL=

# Sentry (optional): the DSN turns on browser error reporting; the rest upload
# source maps during the build.
PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
